<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.CatalogosController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label styleClass="content-title" text="Mantenimiento de Catálogos" />

   <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
     <tabs>
       <!-- TAB NIVELES ACADÉMICOS -->
       <Tab text="Niveles Académicos">
          <content>
             <VBox spacing="14.0">
                <padding>
                   <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
                <TableView fx:id="tblNiveles" onMouseClicked="#eventoSeleccionarNivel" prefHeight="260.0" VBox.vgrow="ALWAYS">
                  <columns>
                    <TableColumn fx:id="colNivelId" prefWidth="60.0" text="ID" />
                    <TableColumn fx:id="colNivelCodigo" prefWidth="140.0" text="Código" />
                    <TableColumn fx:id="colNivelNombre" prefWidth="280.0" text="Nombre" />
                    <TableColumn fx:id="colNivelOrden" prefWidth="80.0" text="Orden" />
                    <TableColumn fx:id="colNivelActivo" prefWidth="100.0" text="Estado" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                </TableView>

                <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 16px; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
                   <children>
                      <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #16233F;" text="Formulario de Nivel Académico (Haga clic en una fila para editarla o cambiar su estado)" />
                      <HBox alignment="CENTER_LEFT" spacing="12.0">
                         <children>
                            <VBox spacing="4.0">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="ID" />
                                  <TextField fx:id="txtNivelId" editable="false" prefWidth="65.0" promptText="Auto" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Código *" />
                                  <TextField fx:id="txtNivelCodigo" prefWidth="130.0" promptText="Ej: MAEST" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Nombre del Nivel Académico *" />
                                  <TextField fx:id="txtNivelNombre" promptText="Ej: Maestría Profesional" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Orden" />
                                  <TextField fx:id="txtNivelOrden" prefWidth="70.0" promptText="1" text="1" />
                               </children>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4.0">
                               <children>
                                  <Label text=" " />
                                  <CheckBox fx:id="chkNivelActivo" selected="true" style="-fx-font-weight: bold;" text="Activo" />
                               </children>
                            </VBox>
                         </children>
                      </HBox>
                      <HBox alignment="CENTER_LEFT" spacing="12.0">
                         <children>
                            <Button fx:id="btnNuevoNivel" mnemonicParsing="false" onAction="#eventoNuevoNivel" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" text="➕ Nuevo" />
                            <Button fx:id="btnGuardarNivel" mnemonicParsing="false" onAction="#eventoGuardarNivel" style="-fx-background-color: #16233F; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6;" text="💾 Guardar" />
                            <Button fx:id="btnEstadoNivel" mnemonicParsing="false" onAction="#eventoCambiarEstadoNivel" style="-fx-background-color: #EB7207; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;" text="🚫 Desactivar" />
                            <Label fx:id="lblMensajeNivel" style="-fx-font-weight: bold;" text="" />
                         </children>
                         <VBox.margin>
                            <Insets top="4.0" />
                         </VBox.margin>
                      </HBox>
                   </children>
                </VBox>
             </VBox>
          </content>
       </Tab>

       <!-- TAB TIPOS DE LOGRO -->
       <Tab text="Tipos de Logro">
          <content>
             <VBox spacing="14.0">
                <padding>
                   <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                </padding>
                <TableView fx:id="tblTiposLogro" onMouseClicked="#eventoSeleccionarTipo" prefHeight="260.0" VBox.vgrow="ALWAYS">
                  <columns>
                    <TableColumn fx:id="colTipoId" prefWidth="60.0" text="ID" />
                    <TableColumn fx:id="colTipoCodigo" prefWidth="130.0" text="Código" />
                    <TableColumn fx:id="colTipoNombre" prefWidth="220.0" text="Nombre" />
                    <TableColumn fx:id="colTipoDescripcion" prefWidth="280.0" text="Descripción" />
                    <TableColumn fx:id="colTipoActivo" prefWidth="100.0" text="Estado" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                </TableView>

                <VBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 16px; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px;">
                   <children>
                      <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #16233F;" text="Formulario de Tipo de Logro (Haga clic en una fila para editarla o cambiar su estado)" />
                      <HBox alignment="CENTER_LEFT" spacing="12.0">
                         <children>
                            <VBox spacing="4.0">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="ID" />
                                  <TextField fx:id="txtTipoId" editable="false" prefWidth="65.0" promptText="Auto" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Código *" />
                                  <TextField fx:id="txtTipoCodigo" prefWidth="130.0" promptText="Ej: CERT" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Nombre *" />
                                  <TextField fx:id="txtTipoNombre" promptText="Ej: Certificación Internacional" />
                               </children>
                            </VBox>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                               <children>
                                  <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Descripción" />
                                  <TextField fx:id="txtTipoDescripcion" promptText="Descripción detallada" />
                               </children>
                            </VBox>
                            <VBox alignment="CENTER" spacing="4.0">
                               <children>
                                  <Label text=" " />
                                  <CheckBox fx:id="chkTipoActivo" selected="true" style="-fx-font-weight: bold;" text="Activo" />
                               </children>
                            </VBox>
                         </children>
                      </HBox>
                      <HBox alignment="CENTER_LEFT" spacing="12.0">
                         <children>
                            <Button fx:id="btnNuevoTipo" mnemonicParsing="false" onAction="#eventoNuevoTipo" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" text="➕ Nuevo" />
                            <Button fx:id="btnGuardarTipo" mnemonicParsing="false" onAction="#eventoGuardarTipo" style="-fx-background-color: #16233F; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6;" text="💾 Guardar" />
                            <Button fx:id="btnEstadoTipo" mnemonicParsing="false" onAction="#eventoCambiarEstadoTipo" style="-fx-background-color: #EB7207; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;" text="🚫 Desactivar" />
                            <Label fx:id="lblMensajeTipo" style="-fx-font-weight: bold;" text="" />
                         </children>
                         <VBox.margin>
                            <Insets top="4.0" />
                         </VBox.margin>
                      </HBox>
                   </children>
                </VBox>
             </VBox>
          </content>
       </Tab>

       <!-- TAB ÁREAS -->
       <Tab text="Áreas">
          <content>
             <VBox alignment="CENTER" spacing="10.0">
                <padding>
                   <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Módulo de Áreas Organizacionales disponible para consulta." />
             </VBox>
          </content>
       </Tab>

       <!-- TAB PUESTOS -->
       <Tab text="Puestos">
          <content>
             <VBox alignment="CENTER" spacing="10.0">
                <padding>
                   <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Módulo de Puestos disponible para consulta." />
             </VBox>
          </content>
       </Tab>

       <!-- TAB ESTADOS LABORALES -->
       <Tab text="Estados Laborales">
          <content>
             <VBox alignment="CENTER" spacing="10.0">
                <padding>
                   <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Módulo de Estados Laborales disponible para consulta." />
             </VBox>
          </content>
       </Tab>
     </tabs>
   </TabPane>
</VBox>
