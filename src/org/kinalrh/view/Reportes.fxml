<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.ReporteController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <!-- ENCABEZADO -->
   <HBox alignment="CENTER_LEFT" spacing="15.0">
      <children>
         <VBox HBox.hgrow="ALWAYS">
            <children>
               <Label styleClass="content-title" text="Reportes y Consulta de Colaboradores Activos" />
               <Label style="-fx-text-fill: #718096; -fx-font-size: 13px;" text="Filtre el personal activo por área o puesto y exporte los resultados a Excel." />
            </children>
         </VBox>
         <Button fx:id="btnExportar" onAction="#eventoExportar" styleClass="btn-save" text="📊 Exportar XLSX / Excel" />
      </children>
   </HBox>

   <Separator />

   <!-- BARRA DE FILTROS -->
   <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f7fafc; -fx-background-radius: 8px; -fx-padding: 12px 15px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
      <children>
         <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Área:" />
         <ComboBox fx:id="cmbArea" prefWidth="220.0" promptText="Todas las áreas" />

         <Label style="-fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Puesto:" />
         <ComboBox fx:id="cmbPuesto" prefWidth="220.0" promptText="Todos los puestos" />

         <Button fx:id="btnLimpiar" onAction="#eventoLimpiar" styleClass="btn-cancel" text="Limpiar Filtros" />
      </children>
   </HBox>

   <!-- RESUMEN DE CONTEO -->
   <HBox alignment="CENTER_LEFT" spacing="15.0">
      <children>
         <Label fx:id="lblContador" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a365d;" text="Colaboradores activos encontrados: 0" />
         <Label style="-fx-text-fill: #cbd5e0;" text="|" />
         <Label fx:id="lblEstadoFiltro" style="-fx-font-size: 13px; -fx-text-fill: #4a5568;" text="Mostrando todos los colaboradores activos." />
      </children>
   </HBox>

   <!-- TABLA DE RESULTADOS -->
   <TableView fx:id="tablaReporte" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
         <TableColumn fx:id="colNombre" prefWidth="280.0" text="Nombre Completo" />
         <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
         <TableColumn fx:id="colArea" prefWidth="220.0" text="Área Principal" />
         <TableColumn fx:id="colPuesto" prefWidth="220.0" text="Puesto Actual" />
      </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>
</VBox>
