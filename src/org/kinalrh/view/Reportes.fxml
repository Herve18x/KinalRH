<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label styleClass="content-title" text="Reportes Exportables" />

   <HBox spacing="15.0">
      <Button text="Reporte de Activos" prefWidth="200.0" />
      <Button text="Reporte por Área" prefWidth="200.0" />
      <Button text="Reporte por Puesto" prefWidth="200.0" />
      <Button text="Reporte de Logros" prefWidth="200.0" />
   </HBox>

   <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
      <Label text="Seleccione un reporte para generar su previsualización o exportarlo a Excel/PDF." style="-fx-text-fill: #666;"/>
   </VBox>
</VBox>
