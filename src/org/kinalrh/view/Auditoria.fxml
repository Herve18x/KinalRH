<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.AuditoriaController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <!-- ENCABEZADO -->
   <VBox spacing="4.0">
      <children>
         <Label styleClass="content-title" text="📜 Log de Auditoría y Trazabilidad" />
         <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px;" text="Registro cronológico e inmutable de altas, ediciones de colaboradores, accesos y operaciones críticas del sistema." />
      </children>
   </VBox>

   <!-- BARRA DE FILTROS Y BÚSQUEDA -->
   <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
      <children>
         <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <children>
               <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Buscar (Acción, Usuario, Entidad, Valor):" />
               <TextField fx:id="txtBusqueda" promptText="🔍 Escriba para filtrar en tiempo real..." />
            </children>
         </VBox>

         <VBox spacing="3.0">
            <children>
               <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Filtrar por Entidad:" />
               <ComboBox fx:id="cmbEntidad" prefWidth="160.0" />
            </children>
         </VBox>

         <VBox spacing="3.0">
            <children>
               <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Límite:" />
               <ComboBox fx:id="cmbLimite" prefWidth="90.0" />
            </children>
         </VBox>

         <VBox alignment="BOTTOM_CENTER" spacing="3.0">
            <children>
               <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#eventoActualizar" style="-fx-background-color: #16233F; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;" text="🔄 Actualizar" />
            </children>
         </VBox>

         <VBox alignment="BOTTOM_CENTER" spacing="3.0">
            <children>
               <Button mnemonicParsing="false" onAction="#eventoLimpiarFiltros" style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 6;" text="Limpiar" />
            </children>
         </VBox>
      </children>
   </HBox>

   <!-- TABLA DE EVENTOS DE AUDITORÍA -->
   <TableView fx:id="tablaAuditoria" onMouseClicked="#eventoDobleClicFila" prefHeight="380.0" VBox.vgrow="ALWAYS">
     <columns>
       <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
       <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha y Hora" />
       <TableColumn fx:id="colUsuario" prefWidth="140.0" text="Usuario / Autor" />
       <TableColumn fx:id="colAccion" prefWidth="180.0" text="Acción Realizada" />
       <TableColumn fx:id="colEntidad" prefWidth="120.0" text="Entidad" />
       <TableColumn fx:id="colRegistroId" prefWidth="75.0" text="ID Reg." />
       <TableColumn fx:id="colCampo" prefWidth="120.0" text="Campo" />
       <TableColumn fx:id="colAnterior" prefWidth="140.0" text="Valor Anterior" />
       <TableColumn fx:id="colNuevo" prefWidth="150.0" text="Valor Nuevo" />
       <TableColumn fx:id="colSesion" prefWidth="200.0" text="Sesión / UUID" />
     </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
   </TableView>

   <!-- BARRA INFERIOR DE ESTADO -->
   <HBox alignment="CENTER_LEFT" spacing="15.0">
      <children>
         <Label fx:id="lblContador" style="-fx-font-weight: bold; -fx-text-fill: #16233F; -fx-font-size: 13px;" text="Cargando registros..." />
         <HBox HBox.hgrow="ALWAYS" />
         <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="💡 Haga doble clic sobre cualquier fila para ver el detalle ampliado del evento." />
      </children>
   </HBox>
</VBox>
