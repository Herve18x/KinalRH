<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="20.0">
      <Label styleClass="content-title" text="Directorio Institucional" />
      <HBox HBox.hgrow="ALWAYS" />
      <TextField prefWidth="300.0" promptText="Buscar colaborador..." />
   </HBox>

   <!-- Contenedor dinámico de tarjetas de empleados -->
   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
      <content>
         <TilePane hgap="20.0" vgap="20.0" prefColumns="4">
            <!-- Ejemplo de una Tarjeta de Directorio (El backend generará estas dinámicamente) -->
            <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #ccc; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-background-color: #fff;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <Label text="👤" style="-fx-font-size: 48px;" />
               <Label style="-fx-font-weight: bold;" text="Nombre del Colaborador" />
               <Label text="Puesto Actual" />
               <Label style="-fx-text-fill: #666;" text="Área Principal" />
               <Label style="-fx-font-size: 10px; -fx-text-fill: #1976D2;" text="Ver Logros Destacados" />
            </VBox>
         </TilePane>
      </content>
   </ScrollPane>
</VBox>
