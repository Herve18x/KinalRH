<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.DirectorioController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="20.0">
      <Label styleClass="content-title" text="Directorio Institucional" />
      <HBox HBox.hgrow="ALWAYS" />
      <TextField fx:id="txtBusqueda" prefWidth="320.0" promptText="Buscar colaborador por nombre, área o puesto..." />
   </HBox>

   <!-- Contenedor dinámico de tarjetas de empleados -->
   <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
      <content>
         <TilePane fx:id="tileDirectorio" hgap="20.0" vgap="20.0" prefColumns="4" style="-fx-padding: 10;">
         </TilePane>
      </content>
   </ScrollPane>
</VBox>
