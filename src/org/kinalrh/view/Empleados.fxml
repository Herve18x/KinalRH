<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.EmpleadoController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label styleClass="content-title" text="Gestión de Empleados" />

   <HBox spacing="10.0">
      <Button fx:id="btnNuevo" onAction="#eventoNuevo" styleClass="btn-action" text="Nuevo Empleado" />
      <Button fx:id="btnRefrescar" onAction="#eventoRefrescar" styleClass="btn-action" text="Refrescar Lista" />
   </HBox>

   <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS" onMouseClicked="#eventoSeleccionTabla">
      <columns>
         <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
         <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
         <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
         <TableColumn fx:id="colArea" prefWidth="150.0" text="Área" />
         <TableColumn fx:id="colPuesto" prefWidth="150.0" text="Puesto" />
      </columns>
   </TableView>
</VBox>