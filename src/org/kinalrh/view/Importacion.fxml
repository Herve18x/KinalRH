<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.ImportacionController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="20.0">
      <Label styleClass="content-title" text="Importación Masiva (Excel)" />
      <HBox HBox.hgrow="ALWAYS" />
      <Button styleClass="btn-action" text="1. Seleccionar Archivo XLSX" onAction="#seleccionarArchivo" />
      <Button styleClass="btn-action" text="2. Validar Datos" onAction="#validar" />
   </HBox>

   <HBox spacing="10.0">
      <Label fx:id="estadoLectura" text="Estado de lectura: Esperando archivo..." />
   </HBox>

   <TableView VBox.vgrow="ALWAYS">
     <columns>
       <TableColumn prefWidth="50.0" text="Fila" />
       <TableColumn prefWidth="120.0" text="DPI" />
       <TableColumn prefWidth="200.0" text="Nombres y Apellidos" />
       <TableColumn prefWidth="150.0" text="Acción Detectada" />
       <TableColumn prefWidth="250.0" text="Validación / Errores" />
     </columns>
   </TableView>

   <HBox alignment="CENTER_RIGHT" spacing="10.0">
      <Label fx:id="registros" text="Registros detectados: 0" />
      <HBox HBox.hgrow="ALWAYS" />
      <Button styleClass="btn-cancel" text="Cancelar" onAction="#cancelar" />
      <Button fx:id="ejecutar" styleClass="btn-save" text="3. Ejecutar Importación" onAction="#confirmar" />
   </HBox>
</VBox>
