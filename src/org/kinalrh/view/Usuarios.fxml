<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.UsuarioController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER_LEFT" spacing="20.0">
      <Label styleClass="content-title" text="Gestión de Cuentas de Usuario" />
      <HBox HBox.hgrow="ALWAYS" />
      <Button fx:id="btnRefrescar" onAction="#eventoRefrescar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-border-color: #cbd5e1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand;" text="🔄 Actualizar" />
      <Button fx:id="btnNuevo" onAction="#eventoNuevo" styleClass="btn-action" text="+ Nuevo Usuario" />
   </HBox>

   <!-- Banner de Alerta Formal: Colaborador(es) sin asignar rol o acceso -->
   <VBox fx:id="bannerAlertaColaboradores" spacing="8.0" style="-fx-background-color: #FFFBEB; -fx-border-color: #F59E0B; -fx-border-width: 1 1 1 4; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 12 16;" visible="false" managed="false">
      <children>
         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
               <Label alignment="CENTER" prefHeight="26.0" prefWidth="26.0" style="-fx-background-color: #D97706; -fx-background-radius: 13; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" text="!" textAlignment="CENTER" />
               <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                  <children>
                     <Label fx:id="lblTituloAlerta" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #92400E;" text="Aviso Formal: Colaborador sin asignar rol o credenciales de acceso" />
                     <Label fx:id="lblDetalleAlerta" style="-fx-font-size: 11px; -fx-text-fill: #78350F;" text="Se detectaron colaboradores registrados en la institución que aún no cuentan con rol ni acceso al sistema." />
                  </children>
               </VBox>
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
               <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #92400E;" text="Colaborador pendiente:" />
               <ComboBox fx:id="cmbColaboradoresPendientes" prefWidth="380.0" promptText="Seleccionar colaborador pendiente..." style="-fx-font-size: 11px;" />
               <Button fx:id="btnAsignarAcceso" onAction="#eventoAsignarAccesoColaborador" style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 5 12; -fx-cursor: hand;" text="👤 Asignar Rol y Acceso" />
            </children>
         </HBox>
      </children>
   </VBox>

   <Label fx:id="lblMensajePermiso" styleClass="panel-message" text="" textFill="RED" visible="false" />

   <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" onMouseClicked="#eventoSeleccionarFicha">
     <columns>
       <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
       <TableColumn fx:id="colUsername" prefWidth="130.0" text="Usuario" />
       <TableColumn fx:id="colNombreVisible" prefWidth="220.0" text="Nombre Visible" />
       <TableColumn fx:id="colRol" prefWidth="210.0" text="Rol(es)" />
       <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
     </columns>
   </TableView>
</VBox>
