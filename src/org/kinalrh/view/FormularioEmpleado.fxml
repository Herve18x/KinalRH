<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.kinalrh.controller.EmpleadoFormController">
   <children>
      <Label fx:id="lblTitulo" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ficha de Empleado" />
      <Label fx:id="lblError" textFill="RED" visible="false" />
      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <javafx.scene.layout.ColumnConstraints minWidth="100.0" />
            <javafx.scene.layout.ColumnConstraints minWidth="200.0" hgrow="ALWAYS" />
         </columnConstraints>
         <children>
            <Label text="ID:" GridPane.rowIndex="0" />
            <TextField fx:id="txtId" editable="false" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="DPI:" GridPane.rowIndex="1" />
            <TextField fx:id="txtDpi" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Primer Nombre:" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrimerNombre" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label text="Primer Apellido:" GridPane.rowIndex="3" />
            <TextField fx:id="txtPrimerApellido" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            
            <Label text="Área:" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbArea" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            
            <Label text="Puesto:" GridPane.rowIndex="5" />
            <ComboBox fx:id="cmbPuesto" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            
            <Label text="Estado:" GridPane.rowIndex="6" />
            <ComboBox fx:id="cmbEstado" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
         </children>
      </GridPane>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#eventoCancelar" text="Cancelar" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#eventoGuardar" style="-fx-background-color: #003366; -fx-text-fill: white;" text="Guardar" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>